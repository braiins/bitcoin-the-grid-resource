@techreport{ercotplanningguide2026,
  author      = {{Electric Reliability Council of Texas}},
  title       = {{ERCOT} Planning Guide},
  institution = {ERCOT},
  date        = {2026},
  url         = {https://www.ercot.com/mktrules/guides/planning/current},
  note        = {The Planning Guide is versioned by section. Section 5, Generator Interconnection or Modification, effective August 1, 2026 (\url{https://www.ercot.com/files/docs/2025/12/01/05-080126.docx}), sec.\ 5.2.1: the generator interconnection process applies to any generator of 1 MW or more and to any settlement-only generator of any size; generators of 10 MW or more require a Security Screening Study and a Full Interconnection Study. Section 9, Large Load Interconnection or Modification, effective July 11, 2026 under PGRR145 (\url{https://www.ercot.com/files/docs/2011/04/28/09-071126.docx}): the Batch Zero large-load interconnection study, including the Withdrawal-Limited Private Use Network (sec.\ 9.2.2.2) and the Provisional Controllable Load Resource (secs.\ 9.2.2.1, 9.3.2, 9.4.1 and 9.6.1). Both are elective, requested by Section 23 Form W or Form X; neither is subject to the minimum allocation threshold that otherwise zeroes an allocation below 100 MW, or below 90 percent of a request of 100 MW or less (sec.\ 9.3.2(7)). ERCOT market notice M-B063026-01 documents the PGRR145 effective date; secs.\ 9.6.1(2)--(3) take effect upon ERCOT system implementation, a project ranked for 2027. Historical versions at \url{https://www.ercot.com/mktrules/guides/planning/library}. Accessed September 4, 2026}
}

